{
  "name": "workstation-console",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "check:runtime": "node scripts/check-mobile-runtime.mjs",
    "update:runtime-lock": "node scripts/update-mobile-runtime-lock.mjs",
    "test:runtime": "playwright test",
    "test:sites": "node --test tests/sites-worker.test.mjs",
    "predev": "npm run check:runtime",
    "dev": "vite",
    "prebuild": "npm run check:runtime",
    "build": "tsc && vite build && node scripts/prepare-sites-build.mjs",
    "build:native": "vite build --config native.config.ts",
    "build:all": "npm run build && npm run build:native",
    "start": "node server/index.mjs"
  },
  "dependencies": {
    "@fontsource/roboto": "5.2.10",
    "@phosphor-icons/react": "^2.1.10",
    "@radix-ui/react-dialog": "1.1.19",
    "@radix-ui/react-dropdown-menu": "2.1.20",
    "@radix-ui/react-icons": "1.3.2",
    "@use-gesture/react": "10.3.1",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "express": "^5.3.0",
    "http-proxy": "^1.18.1",
    "motion": "12.42.2",
    "node-pty": "^1.1.0",
    "nodemailer": "^10.2.1",
    "react": "19.2.7",
    "react-dom": "19.2.7",
    "ws": "^8.22.0"
  },
  "devDependencies": {
    "@playwright/test": "1.61.1",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.3",
    "typescript": "7.0.2",
    "vite": "8.1.3"
  }
}
